import java.io.*;
public class Solution {
    public static void main(String[] args) throws Exception {
        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));
        int n = Integer.parseInt(br.readLine().trim());
        String s = br.readLine().trim();
        String t = s + s;
        int m = t.length();
        int[] odd = new int[m];
        int[] even = new int[m];
        int l = 0, r = -1;
        for (int i = 0; i < m; i++) {
            int k = (i > r) ? 1 : Math.min(odd[l + r - i], r - i + 1);
            while (i - k >= 0 && i + k < m &&
                   t.charAt(i - k) == t.charAt(i + k)) {
                k++;
            }
            odd[i] = k;
            if (i + k - 1 > r) {
                l = i - k + 1;
                r = i + k - 1;
            }
        }
        l = 0;
        r = -1;
        for (int i = 0; i < m; i++) {
            int k = (i > r) ? 0 : Math.min(even[l + r - i + 1], r - i + 1);
            while (i - k - 1 >= 0 && i + k < m &&
                   t.charAt(i - k - 1) == t.charAt(i + k)) {
                k++;
            }
            even[i] = k;
            if (i + k - 1 > r) {
                l = i - k;
                r = i + k - 1;
            }
        }
        int[] answer = new int[n];
        for (int start = 0; start < n; start++) {
            for (int center = start; center < start + n; center++) {
                int radius = Math.min(
                    odd[center],
                    Math.min(center - start + 1, start + n - center)
                );
                if (radius > 0) {
                    answer[start] = Math.max(
                        answer[start],
                        2 * radius - 1
                    );
                }
            }
            for (int center = start + 1; center < start + n; center++) {
                int radius = Math.min(
                    even[center],
                    Math.min(center - start, start + n - center)
                );
                if (radius > 0) {
                    answer[start] = Math.max(
                        answer[start],
                        2 * radius
                    );
                }
            }
        }
        StringBuilder out = new StringBuilder();

        for (int x : answer) {
            out.append(x).append('\n');
        }
        System.out.print(out);
    }
}
